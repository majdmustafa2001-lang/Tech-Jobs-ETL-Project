    {
      "name": "8b63e626",
      "displayName": "hn_skill_trends_unified",
      "config": {
        "version": "1.1",
        "source": "job_market.gold.hn_skill_trends_unified",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "ddf73cce",
      "displayName": "Top Trending Skills in Job Posts from 2018 to 2025",
      "queryLines": [
        "\r\n",
        "SELECT\r\n",
        "    skill,\r\n",
        "    SUM(total_posts) AS mentions\r\n",
        "FROM job_market.gold.hn_skill_trends_unified\r\n",
        "WHERE posted_year BETWEEN 2018 AND 2025\r\n",
        "GROUP BY skill\r\n",
        "ORDER BY mentions DESC\r\n",
        "LIMIT 10;\r\n"
      ]
    },
    {
      "name": "856d73e4",
      "displayName": "top7_skills_other_by_year",
      "queryLines": [
        "\r\n",
        "WITH ranked AS (\r\n",
        "    SELECT\r\n",
        "        posted_year,\r\n",
        "        skill,\r\n",
        "        total_posts,\r\n",
        "\r\n",
        "        ROW_NUMBER() OVER (\r\n",
        "            PARTITION BY posted_year\r\n",
        "            ORDER BY total_posts DESC, skill ASC\r\n",
        "        ) AS rn\r\n",
        "\r\n",
        "    FROM job_market.gold.hn_skill_trends_unified\r\n",
        "),\r\n",
        "\r\n",
        "grouped AS (\r\n",
        "    SELECT\r\n",
        "        posted_year,\r\n",
        "\r\n",
        "        CASE\r\n",
        "            WHEN rn <= 5 THEN skill\r\n",
        "            ELSE 'Other'\r\n",
        "        END AS skill,\r\n",
        "\r\n",
        "        SUM(total_posts) AS total_posts\r\n",
        "\r\n",
        "    FROM ranked\r\n",
        "\r\n",
        "    GROUP BY\r\n",
        "        posted_year,\r\n",
        "        CASE\r\n",
        "            WHEN rn <= 5 THEN skill\r\n",
        "            ELSE 'Other'\r\n",
        "        END\r\n",
        ")\r\n",
        "\r\n",
        "SELECT *\r\n",
        "FROM grouped\r\n",
        "ORDER BY posted_year, total_posts DESC;\r\n"
      ]
    }
  ],
